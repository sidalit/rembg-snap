#!/bin/sh
# Explicit thread counts avoid ONNX Runtime's blocked CPU-affinity calls.
# Keep its default physical-core count unless the user overrides it.
if [ -z "$OMP_NUM_THREADS" ]; then
  cores=$(awk -F: '/^physical id/ { p = $2 } /^core id/ { c[p ":" $2] } END { print length(c) }' /proc/cpuinfo)
  [ "$cores" -gt 0 ] || cores=$(nproc)
  export OMP_NUM_THREADS="$cores"
fi
exec "$@"
